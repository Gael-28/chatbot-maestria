# Gemini
GEMINI_API_KEY=pon_tu_api_key_aqui
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Twilio (consola de Twilio > Account Info)
TWILIO_AUTH_TOKEN=pon_tu_auth_token_aqui
# URL publica de tu servidor (la que te da ngrok), SIN "/" al final
PUBLIC_URL=https://xxxx.ngrok-free.app
VALIDATE_TWILIO=true

# Privacidad: sal para anonimizar telefonos en el registro
PHONE_SALT=cambia_esto
